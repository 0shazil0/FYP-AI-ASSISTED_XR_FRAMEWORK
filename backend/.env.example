# ==============================================================================
# NeuroGuide XR - Backend Environment Configuration Example
# Copy this file to .env and configure the variables for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 2. VLM / LLM REASONING PROVIDER
# ------------------------------------------------------------------------------
# Choose provider: 'ollama' (default / local FYP mode) or 'openai' or 'nim'
USE_NIM=false
LLM_PROVIDER=ollama

# Ollama Settings:
# OLLAMA_MODE=local  -> http://127.0.0.1:11434 (on-prem / workstation)
# OLLAMA_MODE=cloud  -> https://ollama.com (hosted)
OLLAMA_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-vl:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_THINK=false
# OLLAMA_API_KEY=your_ollama_cloud_key_here

# OpenAI / Custom Cloud VLM (Fallback / Cloud Reasoning):
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. SPATIAL SOFTWARE UI COPILOT CONFIGURATION
# ------------------------------------------------------------------------------
COPILOT_SCREEN_WIDTH=1920
COPILOT_SCREEN_HEIGHT=1080
COPILOT_MAX_STEPS=8
COPILOT_MIN_CONFIDENCE=0.0
COPILOT_VERIFY_THRESHOLD=0.008
COPILOT_OLLAMA_MODEL=qwen2.5-vl:7b

# Screen Parser Engines:
# OmniParser (Microsoft): Set true if OmniParser is installed and weights are downloaded
OMNIPARSER_ENABLED=false
OMNIPARSER_REPO_PATH=OmniParser
OMNIPARSER_WEIGHTS_PATH=OmniParser/weights

# PaddleOCR:
PADDLEOCR_ENABLED=true
PADDLEOCR_LANG=en

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DB_DRIVER=sqlite (default file-based SQLite WAL for local workstation)
# DB_DRIVER=postgres (enterprise multi-user deployment)
DB_DRIVER=sqlite
DB_PATH=neuroguide.db
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. PHYSICAL ASSISTANCE & ROBOTICS / VISION SERVICES
# ------------------------------------------------------------------------------
# Default domain persona: gym_trainer | chef | physiotherapist
DEFAULT_PERSONA=gym_trainer

# Roboflow Custom Object Detection (Optional gym equipment classifier)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_PROJECT=gym-project
ROBOFLOW_VERSION=2
ROBOFLOW_CONFIDENCE=40
ROBOFLOW_OVERLAP=30

# WorkoutX API (Exercise demonstration intelligence)
WORKOUTX_API_URL=https://api.workoutxapp.com/v1
WORKOUTX_API_KEY=your_workoutx_api_key_here
WORKOUTX_TIMEOUT=20
