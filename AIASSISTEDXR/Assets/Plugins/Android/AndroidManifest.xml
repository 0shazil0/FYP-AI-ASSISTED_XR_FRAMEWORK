<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom launcher manifest for NeuroGuide XR AR Copilot.
  
  IMPORTANT MERGE NOTES:
  - androidApplicationEntry = 0 (Activity only / UnityPlayerActivity)
  - tools:node="replace" on the activity ensures OUR definition wins over Unity's
    generated one. Without this, Unity's merge sets android:enabled="false" in
    dual-entry mode, making the app install-but-not-launch.
  - android:enabled="true" is explicit here so it is never overridden.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permission for WebSocket connection to Windows backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone permission for hands-free speech queries -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/app_icon"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            tools:node="replace" causes the manifest merger to use THIS activity
            block verbatim and discard the one generated by Unity.
            This prevents android:enabled="false" from being injected when
            androidApplicationEntry was previously set to 2 (dual-mode).
        -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>

        <!-- ARCore: mark as required so the AR session initialises on Android 14/15 -->
        <meta-data android:name="com.google.ar.core" android:value="required" />

    </application>

</manifest>
